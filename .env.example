# AFTRHRS — NEXORA PRODUCTIONS
# Environment Configuration Template
# NOTE: DO NOT PUT ACTUAL SECRETS IN THIS FILE.
# Copy this file to .env and supply your environment variables.

PORT=5001
NODE_ENV=production
PAYMENT_MODE=test
CLIENT_URL=

# RAZORPAY CREDENTIALS (BACKEND ONLY)
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# FRONTEND RAZORPAY PUBLIC KEY
# Only the public Key ID is exposed to the browser for Razorpay Checkout
VITE_RAZORPAY_KEY_ID=

# DATABASE CONFIGURATION
# Supply PostgreSQL / Supabase connection URL for production
# Leave empty for zero-configuration local development SQLite mode
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ADMIN & STAFF SECURITY
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=

# EVENT CONFIGURATION OVERRIDES (Optional)
VENUE_NAME=
VENUE_LOCATION=
VENUE_MAPS_URL=
